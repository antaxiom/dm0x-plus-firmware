import { ComboBox, CheckBox, Slider, LineEdit, ProgressIndicator } from "std-widgets.slint";

// Adwaita-styled custom button with generous padding
component AdwButton inherits Rectangle {
    in property <string> text: "Button";
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked();

    height: 38px;
    min-width: 80px;
    border-radius: 8px;
    background: !root.enabled ? #2a2a2a : (
        root.primary ? (
            touch.pressed ? #1a5fb4 : (touch.has-hover ? #1c71d8 : #3584e4)
        ) : (
            touch.pressed ? #2c2c2c : (touch.has-hover ? #444444 : #383838)
        )
    );
    border-width: root.primary ? 0px : 1px;
    border-color: #424242;
    clip: true;

    animate background { duration: 120ms; }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        alignment: center;
        Text {
            text: root.text;
            color: !root.enabled ? #77767b : #ffffff;
            font-size: 13px;
            font-weight: root.primary ? 600 : 500;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// Adwaita Card Container
component AdwCard inherits Rectangle {
    background: #2e2e2e;
    border-radius: 12px;
    border-width: 1px;
    border-color: #383838;
    clip: true;
}

export component MainWindow inherits Window {
    title: "DM+ Firmware Studio";
    icon: @image-url("../assets/logo.png");
    min-width: 940px;
    min-height: 720px;
    background: #242424;
    default-font-family: "Cantarell, Inter, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif";

    // Callbacks to Rust backend
    callback refresh-ports();
    callback browse-motor-pack();
    callback flash-motor(string, string, string, string, string, bool, int, int);
    callback browse-display-hex();
    callback browse-display-output-hex();
    callback inspect-display-hex(string);
    callback patch-display-hex(string, string);
    callback export-patched-display-hex(string);
    callback flash-display-hex(string, string, bool, bool);

    // Reactive Properties
    in-out property <int> active-tab: 0;
    in-out property <[string]> available-ports: ["No serial devices detected"];
    in-out property <string> selected-motor-port: "No serial devices detected";
    in-out property <string> selected-display-port: "No serial devices detected";
    
    // Motor Tab State
    in-out property <string> motor-firmware-source: "DM01 Open Firmware v0.3.0 (Built-in)";
    in-out property <string> motor-custom-pack-path: "";
    in-out property <string> motor-target: "DM01 (External 12-FET)";
    in-out property <string> battery-voltage: "48V (13S, 54.6V Peak)";
    in-out property <float> max-current-a: 30.0;
    in-out property <string> street-legal-mode: "Unrestricted / Off-Road (Configurable)";
    in-out property <bool> motor-is-flashing: false;
    in-out property <float> motor-progress: 0.0;
    in-out property <string> motor-status: "Ready to flash or test.";

    // Display Tab State
    in-out property <string> display-hex-path: "";
    in-out property <string> display-output-path: "";
    in-out property <string> display-model-name: "—";
    in-out property <string> display-lockout-status: "Load an Intel HEX firmware file to inspect.";
    in-out property <bool> display-is-locked: false;
    in-out property <bool> display-auto-unlock: true;
    in-out property <bool> display-is-flashing: false;
    in-out property <float> display-progress: 0.0;
    in-out property <string> display-status: "Ready.";

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // Top Adwaita HeaderBar
        Rectangle {
            height: 64px;
            background: #303030;
            border-width: 1px;
            border-color: #383838;

            HorizontalLayout {
                padding-top: 10px;
                padding-bottom: 10px;
                padding-left: 24px;
                padding-right: 24px;
                spacing: 20px;
                alignment: space-between;

                // Left: Title and Subtitle
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    min-width: 260px;
                    Text {
                        text: "DM+ Firmware Studio";
                        font-size: 16px;
                        font-weight: 700;
                        color: #ffffff;
                    }
                    Text {
                        text: "ToSeven Mid-Drive Motor Tuning & Display Patching Tool";
                        font-size: 12px;
                        color: #9a9996;
                    }
                }

                // Center: Adwaita Segmented View Switcher (Pill Switcher)
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        height: 40px;
                        min-width: 410px;
                        max-width: 410px;
                        background: #242424;
                        border-radius: 9px;
                        border-width: 1px;
                        border-color: #383838;

                        HorizontalLayout {
                            padding: 3px;
                            spacing: 4px;

                            // Tab 0: Motor Controller
                            Rectangle {
                                min-width: 200px;
                                max-width: 200px;
                                border-radius: 6px;
                                background: root.active-tab == 0 ? #383838 : (tab0-touch.has-hover ? #2e2e2e : transparent);
                                animate background { duration: 100ms; }

                                tab0-touch := TouchArea {
                                    clicked => { root.active-tab = 0; }
                                }

                                Text {
                                    width: 100%;
                                    height: 100%;
                                    text: "Motor Controller";
                                    font-size: 13px;
                                    font-weight: root.active-tab == 0 ? 600 : 500;
                                    color: root.active-tab == 0 ? #ffffff : #9a9996;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            // Tab 1: Display Flasher & Patcher
                            Rectangle {
                                min-width: 200px;
                                max-width: 200px;
                                border-radius: 6px;
                                background: root.active-tab == 1 ? #383838 : (tab1-touch.has-hover ? #2e2e2e : transparent);
                                animate background { duration: 100ms; }

                                tab1-touch := TouchArea {
                                    clicked => { root.active-tab = 1; }
                                }

                                Text {
                                    width: 100%;
                                    height: 100%;
                                    text: "Display Flasher & Patcher";
                                    font-size: 13px;
                                    font-weight: root.active-tab == 1 ? 600 : 500;
                                    color: root.active-tab == 1 ? #ffffff : #9a9996;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // Right: Refresh Ports Button
                HorizontalLayout {
                    alignment: center;
                    min-width: 120px;
                    AdwButton {
                        text: "Refresh Ports";
                        clicked => { root.refresh-ports(); }
                    }
                }
            }
        }

        // Main Content Area
        VerticalLayout {
            padding-top: 24px;
            padding-bottom: 24px;
            padding-left: 24px;
            padding-right: 24px;
            spacing: 16px;
            alignment: start;

            // ==========================================
            // VIEW 1: MOTOR CONTROLLER FLASHER & TUNING
            // ==========================================
            if root.active-tab == 0: VerticalLayout {
                spacing: 16px;
                alignment: start;

                // Firmware Source Selection Card
                AdwCard {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;

                        Text {
                            text: "Firmware Selection";
                            font-size: 15px;
                            font-weight: 700;
                            color: #ffffff;
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                width: 120px;
                                Text {
                                    text: "Firmware Source:";
                                    font-size: 13px;
                                    font-weight: 500;
                                    color: #deddda;
                                }
                            }
                            ComboBox {
                                model: [
                                    "DM01 Open Firmware v0.3.0 (Built-in)",
                                    "DM02 Open Firmware v0.3.0 (Built-in)",
                                    "Custom .Pack File (Manual Selection)"
                                ];
                                current-value <=> root.motor-firmware-source;
                                selected(val) => {
                                    if val == "Custom .Pack File (Manual Selection)" {
                                        root.browse-motor-pack();
                                    } else if val == "DM01 Open Firmware v0.3.0 (Built-in)" {
                                        root.motor-target = "DM01 (External 12-FET)";
                                        if root.max-current-a > 32.0 || root.max-current-a == 18.0 {
                                            root.max-current-a = 30.0;
                                        }
                                    } else if val == "DM02 Open Firmware v0.3.0 (Built-in)" {
                                        root.motor-target = "DM02 (Integrated 6-FET)";
                                        if root.max-current-a > 20.0 || root.max-current-a == 30.0 {
                                            root.max-current-a = 18.0;
                                        }
                                    }
                                }
                                horizontal-stretch: 1;
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                width: 120px;
                                Text {
                                    text: "Pack File:";
                                    font-size: 13px;
                                    font-weight: 500;
                                    color: root.motor-firmware-source == "Custom .Pack File (Manual Selection)" ? #deddda : #9a9996;
                                }
                            }
                            LineEdit {
                                text: root.motor-firmware-source == "DM01 Open Firmware v0.3.0 (Built-in)" ?
                                    "[Embedded Container] TO7-DM01-OpenFirmware-v0.3.0.Pack (128 KB)" : (
                                    root.motor-firmware-source == "DM02 Open Firmware v0.3.0 (Built-in)" ?
                                    "[Embedded Container] TO7-DM02-OpenFirmware-v0.3.0.Pack (128 KB)" :
                                    root.motor-custom-pack-path
                                );
                                placeholder-text: "No file selected (click Choose File...)";
                                read-only: true;
                                enabled: root.motor-firmware-source == "Custom .Pack File (Manual Selection)";
                                horizontal-stretch: 1;
                            }
                            AdwButton {
                                text: "Choose File...";
                                clicked => { root.browse-motor-pack(); }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 16px;

                    // Left Card: Target Hardware & Legal Compliance
                    AdwCard {
                        horizontal-stretch: 1;
                        min-width: 0px;
                        preferred-width: 0px;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 12px;

                            Text {
                                text: "Target Hardware & Legal Compliance";
                                font-size: 15px;
                                font-weight: 700;
                                color: #ffffff;
                            }

                            VerticalLayout {
                                spacing: 4px;
                                Text {
                                    text: root.motor-firmware-source == "Custom .Pack File (Manual Selection)" ?
                                        "Target Hardware Model (Auto-Detected from .Pack)" :
                                        (root.motor-firmware-source == "DM02 Open Firmware v0.3.0 (Built-in)" ?
                                            "Target Hardware Model (Locked: DM02)" :
                                            "Target Hardware Model (Locked: DM01)");
                                    font-size: 13px;
                                    font-weight: 500;
                                    color: #77767b;
                                }
                                ComboBox {
                                    model: [
                                        "DM01 (External 12-FET)",
                                        "DM02 (Integrated 6-FET)",
                                        "Custom / Other Device"
                                    ];
                                    current-value <=> root.motor-target;
                                    enabled: false;
                                }
                            }

                            VerticalLayout {
                                spacing: 4px;
                                Text {
                                    text: "Legal Compliance & Speed Lock";
                                    font-size: 13px;
                                    font-weight: 500;
                                    color: root.motor-firmware-source == "Custom .Pack File (Manual Selection)" ? #77767b : #deddda;
                                }
                                ComboBox {
                                    model: [
                                        "Unrestricted / Off-Road (Configurable)",
                                        "Street-Legal Default (25 km/h, 250W, toggleable)",
                                        "Permanent Street-Legal Lock (EN15194 Tamper-Proof)"
                                    ];
                                    current-value <=> root.street-legal-mode;
                                    enabled: root.motor-firmware-source != "Custom .Pack File (Manual Selection)";
                                }
                            }

                            // Stable, fixed-height compliance info banner (Zero jump, Zero overlap, Libadwaita 8px radius)
                            Rectangle {
                                height: 56px;
                                border-radius: 8px;
                                border-width: 1px;
                                clip: true;
                                background: root.street-legal-mode == "Permanent Street-Legal Lock (EN15194 Tamper-Proof)" ? #0e3a1f : (
                                    root.street-legal-mode == "Street-Legal Default (25 km/h, 250W, toggleable)" ? #1c2e40 : #2a2a2a
                                );
                                border-color: root.street-legal-mode == "Permanent Street-Legal Lock (EN15194 Tamper-Proof)" ? #2ec27e : (
                                    root.street-legal-mode == "Street-Legal Default (25 km/h, 250W, toggleable)" ? #3584e4 : #383838
                                );

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    padding-top: 6px;
                                    padding-bottom: 6px;
                                    alignment: center;

                                    Text {
                                        width: 100%;
                                        height: 100%;
                                        text: root.street-legal-mode == "Permanent Street-Legal Lock (EN15194 Tamper-Proof)" ?
                                            "EN15194 Tamper-Proof: Strictly 25 km/h & 250W continuous. Throttle capped to 6 km/h. Boot combos and display bypasses are permanently locked out." :
                                            (root.street-legal-mode == "Street-Legal Default (25 km/h, 250W, toggleable)" ?
                                                "Street-Legal On Boot: Enforces 25 km/h & 250W limit. Hold Brake Lever + Power-On at startup to temporarily switch to Off-Road mode." :
                                                "Off-Road Mode: Limits configurable up to hardware rating (30A DM01 / 18A DM02). Speed limiter and power ceilings unlocked for off-road use.");
                                        font-size: 11px;
                                        font-weight: 500;
                                        color: root.street-legal-mode == "Permanent Street-Legal Lock (EN15194 Tamper-Proof)" ? #8ff0a4 : (
                                            root.street-legal-mode == "Street-Legal Default (25 km/h, 250W, toggleable)" ? #99c1f1 : #9a9996
                                        );
                                        wrap: word-wrap;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            VerticalLayout {
                                spacing: 4px;
                                Text {
                                    text: "Firmware Safety & Assist Defaults";
                                    font-size: 13px;
                                    font-weight: 500;
                                    color: #deddda;
                                }
                                Rectangle {
                                    height: 36px;
                                    clip: true;
                                    Text {
                                        width: 100%;
                                        height: 100%;
                                        text: "Built-in firmware includes safe open defaults: Gear-Safe progressive cadence ramp (protects nylon gear below 18 RPM) & Unified Level Ceilings. Tunable via display menus.";
                                        font-size: 11px;
                                        color: #77767b;
                                        wrap: word-wrap;
                                        vertical-alignment: top;
                                    }
                                }
                            }
                        }
                    }

                    // Right Card: Battery & Electrical Limits
                    AdwCard {
                        horizontal-stretch: 1;
                        min-width: 0px;
                        preferred-width: 0px;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 12px;

                            Text {
                                text: "Battery & Electrical Limits";
                                font-size: 15px;
                                font-weight: 700;
                                color: #ffffff;
                            }

                            VerticalLayout {
                                spacing: 4px;
                                Text {
                                    text: "Battery Nominal Pack";
                                    font-size: 13px;
                                    font-weight: 500;
                                    color: root.motor-firmware-source == "Custom .Pack File (Manual Selection)" ? #77767b : #deddda;
                                }
                                ComboBox {
                                    model: [
                                        "48V (13S, 54.6V Peak)",
                                        "52V (14S, 58.8V Peak)",
                                        "36V (10S, 42.0V Peak)"
                                    ];
                                    current-value <=> root.battery-voltage;
                                    enabled: root.motor-firmware-source != "Custom .Pack File (Manual Selection)";
                                }
                            }

                            VerticalLayout {
                                spacing: 4px;
                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: "Maximum Sport Current";
                                        font-size: 13px;
                                        font-weight: 500;
                                        color: root.motor-firmware-source == "Custom .Pack File (Manual Selection)" ? #77767b : #deddda;
                                    }
                                    Text {
                                        text: "\{Math.round(root.max-current-a)} A (\{Math.round(root.max-current-a) * 48} W @ 48V)";
                                        font-size: 13px;
                                        font-weight: 600;
                                        color: root.motor-firmware-source == "Custom .Pack File (Manual Selection)" ? #77767b : (
                                            ((root.motor-target == "DM02 (Integrated 6-FET)" && root.max-current-a > 18) ||
                                             (root.motor-target != "DM02 (Integrated 6-FET)" && root.max-current-a > 30)) ? #ff9800 : #3584e4
                                        );
                                    }
                                }
                                Slider {
                                    minimum: 5;
                                    maximum: root.motor-target == "DM02 (Integrated 6-FET)" ? 20 : 32;
                                    value <=> root.max-current-a;
                                    enabled: root.motor-firmware-source != "Custom .Pack File (Manual Selection)";
                                    changed(val) => {
                                        let rounded = Math.round(val);
                                        let cap = root.motor-target == "DM02 (Integrated 6-FET)" ? 20 : 32;
                                        root.max-current-a = Math.min(Math.max(rounded, 5), cap);
                                    }
                                }
                            }

                            // Stable, fixed-height electrical limit banner (Zero jump, Zero overlap, Libadwaita 8px radius)
                            Rectangle {
                                height: 56px;
                                border-radius: 8px;
                                border-width: 1px;
                                clip: true;
                                background: ((root.motor-target == "DM02 (Integrated 6-FET)" && root.max-current-a > 18) ||
                                             (root.motor-target != "DM02 (Integrated 6-FET)" && root.max-current-a > 30)) ? #3d2600 : #2a2a2a;
                                border-color: ((root.motor-target == "DM02 (Integrated 6-FET)" && root.max-current-a > 18) ||
                                               (root.motor-target != "DM02 (Integrated 6-FET)" && root.max-current-a > 30)) ? #ff9800 : #383838;

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    padding-top: 6px;
                                    padding-bottom: 6px;
                                    spacing: 8px;
                                    alignment: center;

                                    if ((root.motor-target == "DM02 (Integrated 6-FET)" && root.max-current-a > 18) ||
                                        (root.motor-target != "DM02 (Integrated 6-FET)" && root.max-current-a > 30)) : Text {
                                        text: "⚠️";
                                        font-size: 13px;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        width: 100%;
                                        height: 100%;
                                        text: (root.motor-target == "DM02 (Integrated 6-FET)" && root.max-current-a > 18) ?
                                            "Warning: Current above 18A exceeds DM02 factory rating (18A max). May cause thermal throttling on internal 6-FET controller." :
                                            ((root.motor-target != "DM02 (Integrated 6-FET)" && root.max-current-a > 30) ?
                                                "Warning: Current above 30A exceeds DM01 factory rating (30A max). Ensure battery and wiring support high continuous draw." :
                                                "Within Factory Rating: Continuous current is within factory thermal specifications (30A DM01 / 18A DM02). Standard cooling dissipation.");
                                        font-size: 11px;
                                        font-weight: 500;
                                        color: ((root.motor-target == "DM02 (Integrated 6-FET)" && root.max-current-a > 18) ||
                                                (root.motor-target != "DM02 (Integrated 6-FET)" && root.max-current-a > 30)) ? #ffb74d : #9a9996;
                                        wrap: word-wrap;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                }
                            }

                            VerticalLayout {
                                spacing: 4px;
                                Text {
                                    text: "Active Hardware Protections";
                                    font-size: 13px;
                                    font-weight: 500;
                                    color: root.motor-firmware-source == "Custom .Pack File (Manual Selection)" ? #77767b : #deddda;
                                }
                                Rectangle {
                                    height: 36px;
                                    clip: true;
                                    Text {
                                        width: 100%;
                                        height: 100%;
                                        text: root.motor-firmware-source == "Custom .Pack File (Manual Selection)" ?
                                            "Custom .Pack file contains its own fixed current tables, voltage cutoffs, and safety limits." :
                                            "Continuous thermal rollback (70°C..100°C), 3.0V LVC reserve cushion with True Zero cutoff, and 500ms Hardware Watchdog (IWDG) are automatically active.";
                                        font-size: 11px;
                                        color: #77767b;
                                        wrap: word-wrap;
                                        vertical-alignment: top;
                                    }
                                }
                            }
                        }
                    }
                }

                // Bottom Card: Serial Port Flasher
                AdwCard {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 14px;

                        Text {
                            text: "Motor Controller Flasher";
                            font-size: 15px;
                            font-weight: 700;
                            color: #ffffff;
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            alignment: start;

                            VerticalLayout {
                                alignment: center;
                                width: 120px;
                                Text {
                                    text: "Serial Port:";
                                    font-size: 13px;
                                    font-weight: 500;
                                    color: #deddda;
                                }
                            }
                            ComboBox {
                                model: root.available-ports;
                                current-value <=> root.selected-motor-port;
                                horizontal-stretch: 1;
                                min-width: 0px;
                            }
                            AdwButton {
                                text: "Refresh";
                                width: 90px;
                                enabled: !root.motor-is-flashing;
                                clicked => {
                                    root.refresh-ports();
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            alignment: space-between;

                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: root.motor-status;
                                    font-size: 13px;
                                    font-weight: 500;
                                    color: #e5a50a;
                                }
                            }

                            // Dedicated side-by-side action buttons
                            HorizontalLayout {
                                spacing: 10px;

                                AdwButton {
                                    text: "Test Flash (Dry Run)";
                                    enabled: !root.motor-is-flashing;
                                    clicked => {
                                        root.flash-motor(
                                            root.motor-firmware-source,
                                            root.motor-custom-pack-path,
                                            root.motor-target,
                                            root.street-legal-mode,
                                            root.selected-motor-port,
                                            true, // dry_run
                                            Math.round(root.max-current-a),
                                            root.battery-voltage == "36V (10S, 42.0V Peak)" ? 36 : (root.battery-voltage == "52V (14S, 58.8V Peak)" ? 52 : 48)
                                        );
                                    }
                                }

                                AdwButton {
                                    text: "Flash Firmware";
                                    primary: true;
                                    enabled: !root.motor-is-flashing;
                                    clicked => {
                                        root.flash-motor(
                                            root.motor-firmware-source,
                                            root.motor-custom-pack-path,
                                            root.motor-target,
                                            root.street-legal-mode,
                                            root.selected-motor-port,
                                            false, // live flash
                                            Math.round(root.max-current-a),
                                            root.battery-voltage == "36V (10S, 42.0V Peak)" ? 36 : (root.battery-voltage == "52V (14S, 58.8V Peak)" ? 52 : 48)
                                        );
                                    }
                                }
                            }
                        }

                        ProgressIndicator {
                            progress: root.motor-progress;
                        }

                        Rectangle {
                            background: #2a1b0a;
                            border-color: #e5a50a;
                            border-width: 1px;
                            border-radius: 8px;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                padding-top: 8px;
                                padding-bottom: 8px;
                                Text {
                                    text: "BENCH TEST ONLY: Open-source firmware must NOT be installed anywhere OTHER than a current-limited bench power supply (<= 1.0A). Do not ride on a bicycle. Provided AS IS with NO WARRANTY. Any equipment damage is solely your own responsibility.";
                                    font-size: 11px;
                                    color: #f6d32d;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
            }

            // ==========================================
            // VIEW 2: DISPLAY FLASHER & LOCKOUT PATCHER
            // ==========================================
            if root.active-tab == 1: VerticalLayout {
                spacing: 16px;
                alignment: start;

                // Card 1: Display Firmware Selection & Inspection
                AdwCard {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;

                        Text {
                            text: "Display Firmware (Intel HEX)";
                            font-size: 15px;
                            font-weight: 700;
                            color: #ffffff;
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                width: 120px;
                                Text {
                                    text: "HEX File:";
                                    font-size: 13px;
                                    font-weight: 500;
                                    color: #deddda;
                                }
                            }
                            LineEdit {
                                text <=> root.display-hex-path;
                                placeholder-text: "No display firmware selected (click Choose File...)";
                                read-only: true;
                                horizontal-stretch: 1;
                            }
                            AdwButton {
                                text: "Choose File...";
                                clicked => { root.browse-display-hex(); }
                            }
                        }

                        // Inspection Badges Row
                        HorizontalLayout {
                            spacing: 24px;
                            HorizontalLayout {
                                spacing: 6px;
                                Text {
                                    text: "Target Model:";
                                    font-size: 13px;
                                    font-weight: 500;
                                    color: #9a9996;
                                }
                                Text {
                                    text: root.display-model-name;
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: #ffffff;
                                }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                Text {
                                    text: "Lockout Status:";
                                    font-size: 13px;
                                    font-weight: 500;
                                    color: #9a9996;
                                }
                                Text {
                                    text: root.display-lockout-status;
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: root.display-is-locked ? #e01b24 : #2ec27e;
                                }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 16px;

                    // Left Card: Lockout Gate Analysis & Patcher
                    AdwCard {
                        horizontal-stretch: 1;
                        min-width: 0px;
                        preferred-width: 0px;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 12px;

                            Text {
                                text: "Lockout Gate Analysis & Patcher";
                                font-size: 15px;
                                font-weight: 700;
                                color: #ffffff;
                            }

                            Rectangle {
                                height: 48px;
                                clip: true;
                                Text {
                                    width: 100%;
                                    height: 100%;
                                    text: "Neutralizes all 6 restriction branch gates (ARM Thumb NOP 0x00BF) introduced in post-October 2024 factory firmware. Restores speed limit configuration up to 60 km/h, enables 12-32 inch wheel sizing, and unlocks menus.";
                                    font-size: 11px;
                                    color: #9a9996;
                                    wrap: word-wrap;
                                    vertical-alignment: top;
                                }
                            }

                            HorizontalLayout {
                                alignment: space-between;
                                VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: root.display-is-locked ?
                                            "Locked gates detected." :
                                            (root.display-hex-path != "" ? "No active restrictions." : "Select firmware above.");
                                        font-size: 13px;
                                        font-weight: 500;
                                        color: root.display-is-locked ? #e5a50a : #9a9996;
                                    }
                                }
                                AdwButton {
                                    text: "Save Patched .hex...";
                                    enabled: root.display-hex-path != "";
                                    clicked => { root.export-patched-display-hex(root.display-hex-path); }
                                }
                            }
                        }
                    }

                    // Right Card: Display ISP Flashing Options & Instructions
                    AdwCard {
                        horizontal-stretch: 1;
                        min-width: 0px;
                        preferred-width: 0px;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 12px;

                            Text {
                                text: "MegaHunt USB ISP Bootloader";
                                font-size: 15px;
                                font-weight: 700;
                                color: #ffffff;
                            }

                            Rectangle {
                                height: 48px;
                                clip: true;
                                Text {
                                    width: 100%;
                                    height: 100%;
                                    text: "Connect display to PC via USB-C. Power off the display, hold the Power or 'M' button while connecting to trigger MegaHunt ISP mode (MH2020C / MH1903 bootloader). Flasher verifies ACK frames and sector pacing automatically.";
                                    font-size: 11px;
                                    color: #9a9996;
                                    wrap: word-wrap;
                                    vertical-alignment: top;
                                }
                            }

                            HorizontalLayout {
                                alignment: start;
                                min-height: 34px;
                                VerticalLayout {
                                    alignment: center;
                                    CheckBox {
                                        text: "Auto-Unlock on Flash (neutralizes 6 restriction gates)";
                                        checked <=> root.display-auto-unlock;
                                    }
                                }
                            }
                        }
                    }
                }

                // USB MegaHunt Display ISP Flasher Card
                AdwCard {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 14px;

                        Text {
                            text: "Display Firmware Flasher";
                            font-size: 15px;
                            font-weight: 700;
                            color: #ffffff;
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            alignment: start;

                            VerticalLayout {
                                alignment: center;
                                width: 120px;
                                Text {
                                    text: "Serial Port:";
                                    font-size: 13px;
                                    font-weight: 500;
                                    color: #deddda;
                                }
                            }
                            ComboBox {
                                model: root.available-ports;
                                current-value <=> root.selected-display-port;
                                horizontal-stretch: 1;
                                min-width: 0px;
                            }
                            AdwButton {
                                text: "Refresh";
                                width: 90px;
                                enabled: !root.display-is-flashing;
                                clicked => {
                                    root.refresh-ports();
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            alignment: space-between;

                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: root.display-status;
                                    font-size: 13px;
                                    font-weight: 500;
                                    color: #e5a50a;
                                }
                            }

                            // Dedicated side-by-side action buttons matching Controller window
                            HorizontalLayout {
                                spacing: 10px;

                                AdwButton {
                                    text: "Test Flash (Dry Run)";
                                    enabled: !root.display-is-flashing && root.display-hex-path != "";
                                    clicked => {
                                        root.flash-display-hex(
                                            root.display-hex-path,
                                            root.selected-display-port,
                                            root.display-auto-unlock,
                                            true // dry_run
                                        );
                                    }
                                }

                                AdwButton {
                                    text: "Flash Firmware";
                                    primary: true;
                                    enabled: !root.display-is-flashing && root.display-hex-path != "";
                                    clicked => {
                                        root.flash-display-hex(
                                            root.display-hex-path,
                                            root.selected-display-port,
                                            root.display-auto-unlock,
                                            false // live flash
                                        );
                                    }
                                }
                            }
                        }

                        ProgressIndicator {
                            progress: root.display-progress;
                        }

                        Rectangle {
                            background: #2a1b0a;
                            border-color: #e5a50a;
                            border-width: 1px;
                            border-radius: 8px;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                padding-top: 8px;
                                padding-bottom: 8px;
                                Text {
                                    text: "DISCLAIMER: Provided AS IS with NO WARRANTY. Flashing firmware carries inherent risk. Any damage to your display, controller, battery, wiring, or bike is entirely your own responsibility.";
                                    font-size: 11px;
                                    color: #f6d32d;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
